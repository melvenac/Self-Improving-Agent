{
  "name": "open-brain",
  "version": "0.1.0",
  "type": "module",
  "description": "Unified knowledge pipeline — the v2 brain",
  "main": "./build/cli.js",
  "bin": {
    "open-brain": "./build/cli.js",
    "open-brain-server": "./build/server.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "dev": "npx tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "postbuild": "node scripts/copy-build-assets.mjs && node scripts/write-build-info.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.11",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1",
    "yaml": "^2.9.1"
  }
}
